# majsqweb — copy to .env.local

# The agent. Server-side only: this URL and the secret below are never exposed
# to the browser (no NEXT_PUBLIC_ prefix) — route handlers proxy every call.
MAJSQ_AGENT_URL=http://localhost:8000
# Must match MAJSQ_SERVICE_SECRET in the agent's .env.
MAJSQ_SERVICE_SECRET=

# CopilotKit's self-hosted runtime needs a model key. Leave the Cloud key blank
# unless you have one — self-hosted is the default so a fork just runs.
OPENAI_API_KEY=
NEXT_PUBLIC_COPILOT_CLOUD_PUBLIC_API_KEY=

# Public site URL, used for share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
